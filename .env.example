# Server-only configuration. Never use VITE_ variables for secrets.
HOST=127.0.0.1
PORT=4311
DATA_DIR=./data
# Consistent automated backup cadence, 0 disables; latest 7 backups retained.
BACKUP_INTERVAL_HOURS=24

# Required for non-loopback binding and all real GitHub writes.
# Set a cryptographically random value of at least 32 characters, entered at operator login.
AUTH_TOKEN=

# Optional explicit browser origin for a reverse proxy, e.g. https://gitnostics.example.org
PUBLIC_ORIGIN=
WRITE_ENABLED=false

# Preferred production integration: GitHub App installation credentials.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=

# Explicit development fallback only; leave disabled in production.
ALLOW_DEVELOPMENT_PAT=false
GITHUB_TOKEN=
